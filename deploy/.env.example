# Скопируйте в ~/bots/presurebot/.env и выполните chmod 600 .env

# Токен бота от @BotFather
TELEGRAM_TOKEN=
# Ключ OpenAI для распознавания фото
OPENAI_API_KEY=
# Модель с поддержкой изображений
OPENAI_MODEL=gpt-4.1
# Строка подключения к MongoDB (тот же кластер Atlas, что у остальных ботов)
MONGODB_URI=
# Telegram ID администратора: у него всегда есть доступ и команды /newuser, /users, /deluser.
# Незнакомцу бот сообщает его ID, а администратору присылает запрос с кнопкой «Разрешить».
ADMIN_USER_ID=
# Список разрешённых хранится в базе (коллекция allowed_users). Эти ID при старте
# добавляются туда при каждом старте, если их там нет: удалённый через /deluser, но
# оставшийся здесь, после перезапуска вернётся. Новых удобнее добавлять через /newuser.
ALLOWED_USER_IDS=

# Напоминания о таблетках. Расписание у каждого своё (команда /pills); у новых
# пользователей напоминания выключены. Это значение при старте один раз переносится
# тем, у кого расписания в базе ещё нет, но кому бот уже напоминал.
PILL_SCHEDULE=вс,вт,чт 04:30; пн,ср 06:30; пт,сб 07:00

# Необязательные настройки (значения по умолчанию)
# PILL_CUTOFF=12:00      # до этого времени повторять напоминание, потом одно финальное
# PILL_REPEAT=10m        # интервал повторов
# MONGODB_DATABASE=pressurebot
# TZ=Asia/Jerusalem
# TREND_HALF_LIFE=72h    # за это время вес измерения в линии тренда падает вдвое
# SESSION_TIMEOUT=20m    # серия без новых замеров сохраняется сама
