# Скопируйте в ~/bots/presurebot/.env и выполните chmod 600 .env

# Токен бота от @BotFather
TELEGRAM_TOKEN=
# Ключ OpenAI для распознавания фото
OPENAI_API_KEY=
# Модель с поддержкой изображений
OPENAI_MODEL=gpt-4.1
# Строка подключения к MongoDB (тот же кластер Atlas, что у остальных ботов)
MONGODB_URI=
# Telegram ID тех, кому можно пользоваться ботом, через запятую.
# Пока список пуст, бот никого не обслуживает, а в ответ на любое сообщение
# сообщает Telegram ID отправителя — так его удобно узнать.
ALLOWED_USER_IDS=

# Необязательные настройки (значения по умолчанию)
# MONGODB_DATABASE=pressurebot
# TZ=Asia/Jerusalem
# TREND_HALF_LIFE=72h    # за это время вес измерения в линии тренда падает вдвое
# SESSION_TIMEOUT=20m    # серия без новых замеров сохраняется сама
